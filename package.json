{
  "name": "@jhlagado/z80-tool-services",
  "version": "0.1.0",
  "description": "Shared host and named-object services for Z80 development tools",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./source-preparation": {
      "types": "./source-preparation/index.d.mts",
      "import": "./source-preparation/index.mjs"
    },
    "./native/z80-tool-services-v1.asmi": "./native/z80-tool-services-v1.asmi",
    "./native/cpm22-final-image.asm": "./native/cpm22-final-image.asm",
    "./native/nobj-consumer.asm": "./native/nobj-consumer.asm",
    "./native/atom-flat-nobj.asm": "./native/atom-flat-nobj.asm",
    "./native/nucleus-nobj.asm": "./native/nucleus-nobj.asm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "native",
    "source-preparation",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhlagado/z80-tool-services.git"
  },
  "bugs": {
    "url": "https://github.com/jhlagado/z80-tool-services/issues"
  },
  "homepage": "https://github.com/jhlagado/z80-tool-services#readme",
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/generate-native-abi.mjs",
    "check:native": "node scripts/generate-native-abi.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"*.md\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:package",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:package": "npm run build && node scripts/smoke-package.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@jhlagado/azm": "^0.3.9",
    "@jhlagado/debug80-runtime": "git+https://github.com/jhlagado/debug80-runtime.git#b7343aa8c38c248abbc6ee801b4af270d4843ad6",
    "@jhlagado/nucleus": "git+https://github.com/jhlagado/nucleus.git#a5371541695789cd56586b96dfe421603395a6b7",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typescript": "5.3.3",
    "vitest": "^4.1.7"
  }
}
